---
import EmailConsultationCta from '../../components/EmailConsultationCta.astro';
import { BUSINESS_INFO, hasConsultationEmail } from '../../data/business';
import { CONSULTATION_TOPICS } from '../../data/consultation';
import SiteLayout from '../../layouts/SiteLayout.astro';

const emailReady = hasConsultationEmail(BUSINESS_INFO);
---

<SiteLayout
  title="상담 안내"
  description="학소 철학관의 상담 분야, 다루는 고민 범위, 사전 준비 정보 및 비용 정책을 안내합니다."
  canonicalPath="/consultation/"
>
  <section class="section">
    <div class="container">
      <span class="badge">상담 분야 및 기대 조정</span>
      <h1 style="margin-top: var(--space-3);">상담 안내 — 어떤 고민을 어떻게 다루나요</h1>
      <p>
        학소 철학관은 초기 상담을 <strong>이메일 서면 상담</strong> 방식으로 운영합니다. 방문자의 편의를 위해 홈페이지에서 제공하는 <strong>무료 기본 사주 체험</strong>과, 개인의 구체적인 질문과 상황을 다루는 <strong>개별 이메일 상담</strong>을 구분하여 안내해 드립니다.
      </p>

      <div class="notice-box" style="margin-top: var(--space-4);">
        <p style="margin: 0 0 0.4rem 0; font-weight: 700; color: var(--color-text-primary);">
          비용 및 운영 방식 안내
        </p>
        <ul style="margin: 0; padding-left: 1.25rem;">
          <li><strong>홈페이지 사주 체험:</strong> 무료 제공 (결제·회원가입·연락처 입력 없음)</li>
          <li><strong>1:1 이메일 상담:</strong> {BUSINESS_INFO.pricingPolicy.emailConsultation}</li>
          <li><strong>상담 채널:</strong> 이메일 상담 전용 (전화·방문·메신저·실시간 영상 상담 미운영)</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>주제별 상담 영역과 사전 준비 사항</h2>
      <div class="topic-detail-list" style="margin-top: var(--space-5);">
        {
          CONSULTATION_TOPICS.map((topic) => (
            <article class="card topic-detail-card" id={`topic-${topic.slug}`}>
              <span class="badge">{topic.title}</span>
              <h3 style="margin-top: var(--space-2);">{topic.subtitle}</h3>

              <p style="font-weight: 700; margin-bottom: var(--space-1); color: var(--color-text-primary);">
                주요 대상 고민
              </p>
              <ul>
                {topic.targetConcerns.map((concern) => (
                  <li>{concern}</li>
                ))}
              </ul>

              <p style="font-weight: 700; margin-bottom: var(--space-1); color: var(--color-text-primary);">
                함께 살피는 내용
              </p>
              <p>{topic.whatWeExamine}</p>

              <p style="font-weight: 700; margin-bottom: var(--space-1); color: var(--color-text-primary);">
                문의 전 준비해 주실 내용
              </p>
              <p style="margin-bottom: 0;">{topic.preparationGuide}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>상담에서 다루지 않는 영역 (윤리 및 한계 기준)</h2>
      <div class="card">
        <ul style="margin: 0; padding-left: 1.25rem;">
          <li>의학적 진단·치료 지시·약물 중단 권유 등 의료 전문가의 영역</li>
          <li>특정 주식·가상자산·부동산 매매 시점 및 종목 지정 등 투자 자문</li>
          <li>법률 소송의 승패 단정이나 세무·법무 자문</li>
          <li>당사자 동의 없는 제3자의 뒷조사나 공포심을 유발하는 단정적 재앙 예언</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" style="border-bottom: none;">
    <div class="container">
      <EmailConsultationCta
        heading={emailReady ? '이메일 상담 신청 안내' : '이메일 상담 개시 준비 안내'}
      />
    </div>
  </section>
</SiteLayout>

<style>
  .topic-detail-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .topic-detail-card {
    scroll-margin-top: 100px;
  }
</style>
