---
import { BUSINESS_INFO, getSafeMailtoHref, hasConsultationEmail } from '../../data/business';
import { EMAIL_CONSULTATION_STEPS } from '../../data/consultation';
import SiteLayout from '../../layouts/SiteLayout.astro';

const emailReady = hasConsultationEmail(BUSINESS_INFO);
const mailtoHref = getSafeMailtoHref(BUSINESS_INFO);
---

<SiteLayout
  title="이메일 상담"
  description="학소 철학관 이메일 서면 상담의 진행 절차, 작성 시 포함할 항목, 접수 및 확정 기준을 안내합니다."
  canonicalPath="/booking/"
>
  <section class="section">
    <div class="container">
      <span class:list={['badge', { 'badge-warn': !emailReady }]}>
        {emailReady ? '이메일 상담 접수 가능' : '이메일 상담 준비 중'}
      </span>
      <h1 style="margin-top: var(--space-3);">이메일 상담 안내</h1>
      <p>
        <strong>{BUSINESS_INFO.name}</strong>은 초기 상담을 <strong>이메일 상담</strong>으로만 진행합니다. 홈페이지 내에 별도의 개인정보 저장용 예약 폼이나 데이터베이스를 두지 않으며, 방문자의 메일 앱에서 직접 문의를 작성·발송하시는 방식으로 운영됩니다.
      </p>

      {
        emailReady && mailtoHref ? (
          <div class="card" style="margin-top: var(--space-5);">
            <h2 style="margin-top: 0;">상담 문의 이메일 연결</h2>
            <p>
              수신 주소: <strong>{BUSINESS_INFO.consultationEmail}</strong>
            </p>
            <div class="btn-row">
              <a href={mailtoHref} class="btn btn-primary" data-cta-action="email-compose">
                메일 앱으로 상담 문의 작성하기
              </a>
              <button
                type="button"
                class="btn btn-secondary"
                data-copy-email={BUSINESS_INFO.consultationEmail}
              >
                이메일 주소 복사
              </button>
            </div>
            <p style="margin: var(--space-3) 0 0 0; font-size: var(--text-xs); color: var(--color-text-muted);">
              주의: 위 버튼을 눌러 메일 작성 창을 열거나 주소를 복사한 것만으로는 상담이 발송·접수·확정되지 않습니다. 메일 발송 후 학소의 접수 확인 회신을 받아야 상담 진행이 확정됩니다.
            </p>
          </div>
        ) : (
          <div class="notice-box warning" style="margin-top: var(--space-5);">
            <h2 style="margin-top: 0; font-size: var(--text-lg);">현재 이메일 상담 준비 중입니다</h2>
            <p style="margin-bottom: var(--space-2);">
              상담 전용 이메일 주소와 항목별 세부 비용·회신 기한이 확정되는 대로 이 페이지에 공지됩니다. 이메일 주소 확정 전에는 임시 주소나 자동 발송 링크를 제공하지 않습니다.
            </p>
            <p style="margin: 0;">
              기다리시는 동안 홈페이지에서 제공하는 <strong>무료 기본 사주 체험</strong>을 제한 없이 이용해보실 수 있습니다.
            </p>
            <div class="btn-row" style="margin-top: var(--space-4);">
              <a href="/saju/" class="btn btn-primary">무료 기본 사주 체험하기</a>
              <a href="/consultation/" class="btn btn-secondary">상담 분야 먼저 살펴보기</a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>이메일 작성·발송·접수·확정의 구분</h2>
      <p>
        혼선을 줄이기 위해 메일 작성부터 최종 답변 전달까지의 네 단계를 명확히 구분하여 안내합니다.
      </p>
      <div class="grid-2" style="margin-top: var(--space-5);">
        {
          EMAIL_CONSULTATION_STEPS.map((step) => (
            <article class="card">
              <span class="badge">단계 0{step.stepNumber}</span>
              <h3 style="margin-top: var(--space-2);">{step.title}</h3>
              <p>{step.description}</p>
              <p style="margin: 0; font-size: var(--text-xs); color: var(--color-text-muted);">{step.statusNote}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="border-bottom: none;">
    <div class="container">
      <h2>상담 이메일 작성 시 적어주실 내용 (추후 접수 개시 시 참고)</h2>
      <div class="card">
        <ol style="margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: var(--space-2);">
          <li>
            <strong>출생 연·월·일 및 양력/음력(평달·윤달) 구분:</strong> 예) 양력 1992년 10월 24일 또는 음력 1992년 평9월 29일
          </li>
          <li>
            <strong>출생 시각 또는 시간 모름 여부:</strong> 정확한 시·분을 아시면 기재해 주시고, 모르시면 "출생 시간 모름"으로 적어 주세요.
          </li>
          <li>
            <strong>출생 지역 여부:</strong> 대한민국 국내 출생 여부 (해외 출생인 경우 국가·도시명을 함께 기재)
          </li>
          <li>
            <strong>상담 희망 주제와 구체적인 질문 1~2가지:</strong> 현재 겪고 계신 상황과 선택지들을 편하게 적어 주세요. 주민등록번호, 상세 자택 주소, 계좌번호 등 불필요한 민감정보는 절대 기재하지 마세요.
          </li>
        </ol>
      </div>
    </div>
  </section>
</SiteLayout>
