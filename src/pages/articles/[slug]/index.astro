---
import { getCollection, render } from 'astro:content';
import EmailConsultationCta from '../../../components/EmailConsultationCta.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { filterApprovedEntries } from '../../../lib/content/filter';

export async function getStaticPaths() {
  const allArticles = await getCollection('articles');
  const approved = filterApprovedEntries(allArticles);
  return approved.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/articles/${entry.id}/`}
>
  <article class="section">
    <div class="container">
      <span class="badge">{entry.data.category}</span>
      <h1 style="margin-top: var(--space-3);">{entry.data.title}</h1>
      <p style="font-size: var(--text-xs); color: var(--color-text-muted);">
        발행일: {entry.data.publishedAt} · 작성: {entry.data.author} · 검수: {entry.data.reviewer}
      </p>
      <div class="card" style="margin-top: var(--space-5);" data-protected-content="true">
        <Content />
      </div>
      <div class="btn-row" style="margin-top: var(--space-5);">
        <a href="/articles/" class="btn btn-secondary">칼럼 목록으로 돌아가기</a>
      </div>
    </div>
  </article>

  <section class="section" style="border-bottom: none;">
    <div class="container">
      <EmailConsultationCta />
    </div>
  </section>
</SiteLayout>
