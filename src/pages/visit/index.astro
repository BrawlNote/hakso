---
import EmailConsultationCta from '../../components/EmailConsultationCta.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="상담 준비 안내"
  description="학소 철학관 이메일 상담은 준비 중입니다. 상담 개시 일정과 이용 방법은 추후 안내드립니다."
  canonicalPath="/visit/"
  noindex
>
  <section class="section">
    <div class="container">
      <span class="badge">상담 준비 중</span>
      <h1 style="margin-top: var(--space-3);">상담 준비 안내</h1>
      <p>
        이메일 상담을 준비하고 있습니다. 상담 개시 일정과 이용 방법은 추후 안내드립니다.
      </p>

      <div class="card" style="margin-top: var(--space-5);">
        <h2 style="margin-top: 0;">상담 운영 안내</h2>
        <div class="notice-box warning">
          <p style="margin: 0 0 0.4rem 0; font-weight: 700; color: var(--color-text-primary);">
            방문 상담 미운영 안내
          </p>
          <p style="margin: 0;">
            현재 방문 상담과 전화 예약 접수는 받지 않습니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="border-bottom: none;">
    <div class="container">
      <EmailConsultationCta />
    </div>
  </section>
</SiteLayout>
