---
import EmailConsultationCta from '../../components/EmailConsultationCta.astro';
import { BUSINESS_INFO } from '../../data/business';
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="소재지 안내"
  description="학소 철학관의 사업장 소재지(서울 강북구 한천로 1167 3층) 및 초기 이메일 상담 전용 운영 안내입니다."
  canonicalPath="/visit/"
>
  <section class="section">
    <div class="container">
      <span class="badge">사업장 소재지 안내</span>
      <h1 style="margin-top: var(--space-3);">소재지 및 상담 방식 안내</h1>
      <p>
        <strong>{BUSINESS_INFO.name}</strong>의 사업장 소재지와 현재 운영 중인 상담 방식을 안내합니다.
      </p>

      <div class="card" style="margin-top: var(--space-5);">
        <h2 style="margin-top: 0;">주소 정보</h2>
        <p style="font-size: var(--text-lg); font-weight: 700; color: var(--color-text-primary);">
          {BUSINESS_INFO.address.full}
        </p>
        <div class="notice-box warning">
          <p style="margin: 0 0 0.4rem 0; font-weight: 700; color: var(--color-text-primary);">
            방문 상담 미운영 안내
          </p>
          <p style="margin: 0;">
            {BUSINESS_INFO.address.note}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="border-bottom: none;">
    <div class="container">
      <EmailConsultationCta />
    </div>
  </section>
</SiteLayout>
