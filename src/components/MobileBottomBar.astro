---
import { BUSINESS_INFO, hasConsultationEmail } from '../data/business';

const emailReady = hasConsultationEmail(BUSINESS_INFO);
---

<nav class="mobile-bottom-bar" aria-label="모바일 빠른 이동">
  <a href="/saju/" class="btn btn-primary mobile-bar-btn">무료 사주 보기</a>
  <a href="/booking/" class="btn btn-secondary mobile-bar-btn">
    {emailReady ? '이메일 상담 문의' : '이메일 상담 안내'}
  </a>
</nav>

<style>
  .mobile-bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background-color: var(--color-bg-surface);
    border-top: 1px solid var(--color-border-strong);
    padding: var(--space-2) var(--space-4) calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    box-shadow: 0 -2px 10px rgba(28, 27, 24, 0.08);
  }

  .mobile-bar-btn {
    width: 100%;
    min-height: 46px;
    padding: 0.5rem 0.65rem;
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .mobile-bottom-bar {
      display: none;
    }
  }
</style>
