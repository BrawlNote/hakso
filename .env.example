# 학소 철학관 환경 변수 예시 (.env.example)
# 주의: 실제 비밀 키나 개인 정보를 이 파일이나 PUBLIC_* 변수에 넣지 마세요.
# 초기 A+B(홍보 홈페이지 + 브라우저 무료 기본 사주)는 별도 API 키 없이 동작합니다.

# 배포 대상 사이트 대표 URL (미확정 시 기본 예시 URL 사용, 운영 도메인 확정 시 변경)
SITE_URL=https://hakso.kr

# 환경 구분: development | preview | production
# preview 환경에서는 검색엔진 색인 방지(noindex)가 기본 적용됩니다.
PUBLIC_DEPLOY_ENV=development
